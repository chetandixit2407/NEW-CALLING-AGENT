{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated recruiter or HR team member.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "description": "Recruiter work email address" },
        "displayName": { "type": "string", "description": "Recruiter display name" },
        "photoURL": { "type": "string", "description": "Profile picture URL" },
        "role": { "type": "string", "enum": ["recruiter", "admin", "hr_manager"], "description": "Role within White Collar Realty HR team" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account creation timestamp" },
        "lastLoginAt": { "type": "string", "format": "date-time", "description": "Last sign-in timestamp" }
      },
      "required": ["uid", "email"]
    },
    "Candidate": {
      "title": "Candidate",
      "description": "Screened real estate candidate for White Collar Realty Gurgaon luxury & ultra-luxury residential sales advisory roles.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Candidate unique ID" },
        "name": { "type": "string", "description": "Candidate full name" },
        "phone": { "type": "string", "description": "Contact mobile number" },
        "email": { "type": "string", "description": "Candidate email address" },
        "appliedRole": { "type": "string", "description": "Applied role (e.g. Sales Manager Luxury Real Estate)" },
        "status": { "type": "string", "description": "Recruitment pipeline status" },
        "priority": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"], "description": "Recruiter prioritization level" },
        "appliedDate": { "type": "string", "description": "Application date" },
        "isCalling": { "type": "boolean", "description": "Calling lock flag preventing simultaneous outbound calls" },
        "activeCallId": { "type": "string", "description": "ID of currently active call session" },
        "callStartedAt": { "type": "string", "description": "Timestamp when calling lock was acquired" },
        "callEndedAt": { "type": "string", "description": "Timestamp when calling lock was released" },
        "unansweredAttempts": { "type": "number", "description": "Count of unanswered call attempts" },
        "interviewSlotId": { "type": "string", "description": "Booked interview slot reference" },
        "interviewDate": { "type": "string", "description": "Scheduled interview date" },
        "interviewTime": { "type": "string", "description": "Scheduled interview time" },
        "notes": { "type": "string", "description": "HR recruiter notes and timeline logs" },
        "lastEmailSentAt": { "type": "string", "description": "Timestamp of confirmation email dispatch" },
        "lastWhatsAppSentAt": { "type": "string", "description": "Timestamp of WhatsApp reminder dispatch" },
        "scheduledCall": {
          "type": "object",
          "description": "Scheduled AI auto-trigger call details with date, time, and conversation scenario.",
          "properties": {
            "scheduledAt": { "type": "string", "description": "ISO timestamp for auto-triggering" },
            "date": { "type": "string", "description": "Target call date" },
            "time": { "type": "string", "description": "Target call time" },
            "scenario": { "type": "string", "description": "Call scenario" },
            "notes": { "type": "string", "description": "Special instructions for AI agent" },
            "status": { "type": "string", "enum": ["pending", "triggered", "completed", "cancelled"], "description": "Scheduled call execution status" }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Record last modification timestamp" }
      },
      "required": ["id", "name", "phone", "appliedRole", "status"]
    },
    "InterviewSlot": {
      "title": "InterviewSlot",
      "description": "Face-to-face interview slot at White Collar Realty Gurugram office (M3M Urbana Sector 67).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Slot identifier" },
        "date": { "type": "string", "description": "Interview slot date" },
        "time": { "type": "string", "description": "Interview slot time" },
        "displayLabel": { "type": "string", "description": "Human readable slot label" },
        "status": { "type": "string", "enum": ["Available", "Booked", "Completed", "Cancelled"], "description": "Slot availability" },
        "isAvailable": { "type": "boolean", "description": "Availability flag" },
        "maxCapacity": { "type": "number", "description": "Maximum concurrent candidates per slot" },
        "bookedCount": { "type": "number", "description": "Current number of booked candidates" },
        "bookedCandidateId": { "type": "string", "description": "Associated candidate ID if booked" },
        "bookedCandidateName": { "type": "string", "description": "Associated candidate name if booked" },
        "venue": { "type": "string", "description": "Interview venue address" }
      },
      "required": ["id", "date", "time", "isAvailable"]
    },
    "CallLog": {
      "title": "CallLog",
      "description": "Conversation log, full transcript, scorecard, and post-call analytics.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Call log unique identifier" },
        "candidateId": { "type": "string", "description": "Candidate ID" },
        "candidateName": { "type": "string", "description": "Candidate name" },
        "scenario": { "type": "string", "description": "Screening scenario type" },
        "timestamp": { "type": "string", "format": "date-time", "description": "Call start timestamp" },
        "durationSeconds": { "type": "number", "description": "Duration of call in seconds" },
        "summary": { "type": "string", "description": "Factual conversation summary" },
        "outcome": { "type": "string", "description": "Outcome of screening call" }
      },
      "required": ["id", "candidateId", "timestamp"]
    },
    "CandidateLongTermMemory": {
      "title": "CandidateLongTermMemory",
      "description": "Single persistent source of learned candidate facts across multiple calls.",
      "type": "object",
      "properties": {
        "candidateId": { "type": "string", "description": "Unique Candidate ID" },
        "candidateName": { "type": "string", "description": "Candidate name" },
        "lastUpdated": { "type": "string", "description": "Last update timestamp" }
      },
      "required": ["candidateId", "candidateName"]
    },
    "CandidateBehaviorReport": {
      "title": "CandidateBehaviorReport",
      "description": "Observable communication style, engagement, and conversational signals report.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Report ID" },
        "candidateId": { "type": "string", "description": "Candidate ID" },
        "timestamp": { "type": "string", "description": "Report generation timestamp" },
        "humanReviewRequired": { "type": "boolean", "description": "Flag indicating human HR review needed" }
      },
      "required": ["id", "candidateId", "timestamp"]
    },
    "FollowupRecord": {
      "title": "FollowupRecord",
      "description": "Scheduled recruiter or AI agent follow-up task.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Followup task ID" },
        "candidateId": { "type": "string", "description": "Candidate ID" },
        "type": { "type": "string", "description": "Type of followup" },
        "scheduledAt": { "type": "string", "description": "Due timestamp" },
        "status": { "type": "string", "enum": ["PENDING", "IN_PROGRESS", "COMPLETED", "CANCELLED"], "description": "Task status" }
      },
      "required": ["id", "candidateId", "type", "scheduledAt", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Recruiter and HR manager user profiles."
    },
    "/candidates/{candidateId}": {
      "schema": "Candidate",
      "description": "Candidate roster documents for White Collar Realty hiring pipeline."
    },
    "/interview_slots/{slotId}": {
      "schema": "InterviewSlot",
      "description": "Calendar slots for face-to-face interviews at Sector 67 Gurugram."
    },
    "/call_logs/{callId}": {
      "schema": "CallLog",
      "description": "Historical voice call transcripts, outcomes, and screening logs."
    },
    "/candidate_memories/{candidateId}": {
      "schema": "CandidateLongTermMemory",
      "description": "Cross-call memory and extracted fact repository for candidate."
    },
    "/behavior_reports/{reportId}": {
      "schema": "CandidateBehaviorReport",
      "description": "Individual call communication behavior and conversational signals."
    },
    "/behavior_profiles/{candidateId}": {
      "schema": "CandidateBehaviorReport",
      "description": "Aggregated multi-call behavior profile."
    },
    "/learning_proposals/{proposalId}": {
      "schema": "User",
      "description": "System-wide recruitment optimization learning proposals."
    },
    "/human_feedback/{feedbackId}": {
      "schema": "User",
      "description": "Recruiter overrides and human decision logs."
    },
    "/memory_audit_trail/{auditId}": {
      "schema": "User",
      "description": "Provenance audit log for all candidate memory field mutations."
    },
    "/question_stats/{statId}": {
      "schema": "User",
      "description": "Effectiveness statistics for screening questions."
    },
    "/scenario_stats/{statId}": {
      "schema": "User",
      "description": "Effectiveness statistics for sales scenarios."
    },
    "/followups/{followupId}": {
      "schema": "FollowupRecord",
      "description": "Scheduled recruitment follow-up queue."
    }
  }
}
